# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Visual verification output — regenerated by `pnpm shoot`
.shots/

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Playwright MCP scratch output — snapshots and console logs from driving the
# browser during review. Untracked, and ignored by prettier: its .yml files
# otherwise fail `pnpm format:check`, which fails CI for no reason at all.
.playwright-mcp/
